use flake

watch_file secretspec.toml
watch_file .env
watch_file bluesky_agent.toml

# Structural settings live in the untracked TOML file; SecretSpec injects only
# declared credentials from the selected provider.
export BLUESKY_AGENT_CONFIG="${BLUESKY_AGENT_CONFIG:-$PWD/bluesky_agent.toml}"
direnv_load secretspec run --provider dotenv --reason "Develop bluesky-agent" -- direnv dump
