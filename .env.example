# Copy this file to .env for SecretSpec's dotenv provider. Replace placeholders,
# keep only the model/search providers you use, and never commit .env.
BLUESKY_AGENT_APP_PASSWORD=<agent-bluesky-app-password>
BLUESKY_AGENT_GITHUB_TOKEN=<research-wiki-github-token>

# Keep at least one model-provider key matching omp_model in bluesky_agent.toml.
ANTHROPIC_API_KEY=<anthropic-api-key>
# OPENAI_API_KEY=<openai-api-key>
# OPENAI_BASE_URL=<openai-compatible-endpoint>
# GEMINI_API_KEY=<gemini-api-key>
# OPENROUTER_API_KEY=<openrouter-api-key>

# Optional non-secret overrides for Manifest-hosted prompt classification.
# The same names are available as intent_model and intent_timeout in
# bluesky_agent.toml. Routing fails open if the gateway is unavailable.
# BLUESKY_AGENT_INTENT_MODEL=auto
# BLUESKY_AGENT_INTENT_TIMEOUT=10.0

# Optional keyed search providers. OMP also supports credential-free search.
# EXA_API_KEY=<exa-api-key>
# BRAVE_API_KEY=<brave-search-api-key>
# TAVILY_API_KEY=<tavily-api-key>
